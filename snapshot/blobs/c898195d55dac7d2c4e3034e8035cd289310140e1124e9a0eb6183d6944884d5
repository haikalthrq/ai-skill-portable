{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "reserved": 10000
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "ecc-memory-vault": {
      "type": "local",
      "command": [
        "node",
        "__PORTABLE_HOME__/.agents/skills/cross-harness-handoff/scripts/memory-mcp.mjs"
      ],
      "enabled": true,
      "environment": {
        "ECC_MEMORY_HARNESS": "opencode"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "plugin": [
    "file:///__PORTABLE_HOME__/.opencode/.opencode/plugins/graphify.js",
    "file:///__PORTABLE_HOME__/.opencode/opencode-codex-identity-plugin.ts",
    "file:///__PORTABLE_HOME__/.opencode/plugins/dcg-guard.js"
  ],
  "skills": {
    "paths": [
      "__PORTABLE_HOME__/.agents/skills",
      "__PORTABLE_HOME__/.claude/skills",
      "__PORTABLE_HOME__/.config/opencode/skills",
      "__PORTABLE_HOME__/.opencode/skills"
    ]
  }
}
