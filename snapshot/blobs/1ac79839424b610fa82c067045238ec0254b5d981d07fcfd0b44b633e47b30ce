import { spawn } from "child_process";
import { existsSync } from "fs";
import { join } from "path";

const which = (cmd) => {
  const dirs = (process.env.PATH || "").split(process.platform === "win32" ? ";" : ":");
  for (const dir of dirs) {
    const p = join(dir, cmd);
    if (existsSync(p)) return p;
    const pExe = join(dir, cmd + ".exe");
    if (existsSync(pExe)) return pExe;
  }
  return null;
};

export const DcgGuard = async () => {
  const dcg = which("dcg");
  if (!dcg) return {};

  return {
    "tool.execute.before": async (input, output) => {
      if (input.tool !== "bash") return;
      const payload = JSON.stringify({
        tool_name: "Bash",
        tool_input: { command: output.args.command },
      });
      const result = await new Promise((resolve, reject) => {
        const proc = spawn(dcg, [], {
          stdio: ["pipe", "pipe", "pipe"],
          env: { ...process.env, DCG_ROBOT: "1" },
        });
        let stdout = "";
        let stderr = "";
        proc.stdout.on("data", (chunk) => { stdout += chunk; });
        proc.stderr.on("data", (chunk) => { stderr += chunk; });
        proc.on("error", reject);
        proc.on("close", () => {
          resolve({ stdout: stdout.trimEnd(), stderr });
        });
        proc.stdin.write(payload);
        proc.stdin.end();
      });
      const lines = result.stdout.split("\n");
      const last = lines[lines.length - 1]?.trim();
      if (!last) return;
      try {
        const parsed = JSON.parse(last);
        if (parsed?.hookSpecificOutput?.permissionDecision === "deny") {
          const reason =
            parsed.hookSpecificOutput.permissionDecisionReason ?? "blocked by dcg";
          throw new Error(reason);
        }
      } catch (e) {
        if (e instanceof SyntaxError) return;
        throw e;
      }
    },
  };
};
